mapscripts OlivineCity_PortInside_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_BADGE08_GET) && !flag(FLAG_CANSAIL_FARAWAYISLAND)) {
            clearflag(FLAG_HIDE_BLAINE_OLIVINEPORT)
        } else {
            setflag(FLAG_HIDE_BLAINE_OLIVINEPORT)
        }
    }
}

script OlivinePort_Sailor {
	if (!flag(FLAG_CANSAIL_FARAWAYISLAND)) {
		msgbox("抱歉，这船一时半会儿\n哪儿都不会去。", MSGBOX_NPC)
	} else { 
		msgbox("有人吩咐我把你送到一个\n非常具体的地点。\l你现在就要去吗？", MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			msgbox("哦，好吧……")
			release
			end
		}
		msgbox("那就出发吧！\p起锚！我们要扬帆\n驶向未知的远方！")
		closemessage
		warp(MAP_FARAWAY_ISLAND_OUTSIDE, 13, 38)
		waitstate
		release
		end
	}	
}

script OlivinePortBlaine {
	lock
	if (flag(FLAG_CANSAIL_FARAWAYISLAND)) {
		msgbox("夏伯：我已经把岛的事\n告诉水手了。")
		release
		end
	}
	if (!flag(FLAG_TEMP_5)) {
		msgbox("？？？：啊……还是\n劲爽汽水最痛快！")
		faceplayer
		msgbox("哦！那是城都的8枚徽章吗？\p能集齐这些，你一定是位\n相当了不起的训练家！\p我叫夏伯，是另一个地区的\n道馆馆主。\p夏伯：哦！我有个好主意！\p来答个问题吧！")
		msgbox("夏伯：你害怕未知吗？", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			msgbox("哦……答错了！")
			release
			end
		}
		msgbox("夏伯：很好！\p下一个问题！\p你觉得能在宝可梦对战中\n打赢我吗？", MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			msgbox("夏伯：我欣赏你的诚实，\n不过你该对自己\l多一点信心！")
			setflag(FLAG_TEMP_5)
			release
			end
		}
	}
	if (flag(FLAG_TEMP_5)) {
		msgbox("关于上一个问题的\n想法改变了吗？\p你觉得能在宝可梦对战中\n打赢我吗？", MSGBOX_YESNO)
		if (var(VAR_RESULT) == NO) {
			msgbox("夏伯：还是没什么信心？\n这也难怪。\p毕竟我可是个热情似火的人！\n呵呵呵！")
			release
			end
		}
	}
	playbgm(MUS_RG_ENCOUNTER_GYM_LEADER, FALSE)
	msgbox("夏伯：说得真够大胆！\n我现在就来验证一下！")
	msgbox("希望你带了灼伤药！")
	trainerbattle_no_intro(TRAINER_BLAINE_OLIVINE, "哇！你把我烧着了！")
	createfieldmugshot(MUGSHOT_BLAINE)
	msgbox("夏伯：好烫！我被烧到了！\n你果然是真本事！\p事情是这样的。我来城都\n是为了看望老朋友大木，\l他正好也在这里。\p我找到了一张旧地图，\n那是我们很久以前\l去过的一座岛。\p我想那之后\n就再没人去过那儿了。\p我会把这座岛告诉水手。\n你想去的话就去找他。\p说不定能在那里\n找到稀有的宝可梦！")
	closemessage
	moveobjecttocoords(LOCALID_OLI_BLAINE, 8, 16, DIR_SOUTH)
	waitmovement(0)
	turnobject(LOCALID_PLAYER, DIR_SOUTH)
	delay(60)
	moveobjecttocoords(LOCALID_OLI_BLAINE, 8, 12, DIR_NORTH)
	waitmovement(0)
	turnobject(LOCALID_PLAYER, DIR_EAST)
	turnobject(LOCALID_OLI_BLAINE, DIR_WEST)
	createfieldmugshot(MUGSHOT_BLAINE)
	msgbox("祝你好运！")
	closemessage
	applymovement(LOCALID_OLI_BLAINE, moves(walk_up*3))
	waitmovement
	playse(SE_EXIT)
	removeobject(LOCALID_OLI_BLAINE)
	setflag(FLAG_CANSAIL_FARAWAYISLAND)
	setflag(FLAG_HIDE_BLAINE_OLIVINEPORT)
	release
	end
}