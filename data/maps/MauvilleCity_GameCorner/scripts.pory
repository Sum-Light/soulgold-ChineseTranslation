	.string ""
`

script MauvilleCity_GameCorner_EventScript_ChooseNewPrize {
	dynmultichoice(12, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, "秘密琥珀{CLEAR_TO 0x40}4000",
																"日之石{CLEAR_TO 0x40}2000",
																"月之石{CLEAR_TO 0x40}2000",
																"联系绳{CLEAR_TO 0x40}2500",
																"美丽鳞片{CLEAR_TO 0x40}3000",
																"取消")
	switch (var(VAR_RESULT))
    {
        case 0: goto(MauvilleCity_GameCorner_EventScript_OldAmber)
        case 1: goto(MauvilleCity_GameCorner_EventScript_SunStone)
        case 2: goto(MauvilleCity_GameCorner_EventScript_MoonStone)
        case 3: goto(MauvilleCity_GameCorner_EventScript_LinkingCord)
        case 4: goto(MauvilleCity_GameCorner_EventScript_PrismScale)
        default: goto(MauvilleCity_GameCorner_EventScript_CancelTMSelect)
    }
	end
    }

script MauvilleCity_GameCorner_EventScript_ChooseNewPrize2 {
	dynmultichoice(12, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, "火之石{CLEAR_TO 0x40}2000",
																"雷之石{CLEAR_TO 0x40}2000",
																"水之石{CLEAR_TO 0x40}2000",
																"叶之石{CLEAR_TO 0x40}2000",
																"取消")
	switch (var(VAR_RESULT)) {
	case 0: goto(MauvilleCity_GameCorner_EventScript_FireStone)
	case 1: goto(MauvilleCity_GameCorner_EventScript_ThunderStone)
	case 2: goto(MauvilleCity_GameCorner_EventScript_WaterStone)
	case 3: goto(MauvilleCity_GameCorner_EventScript_LeafStone)
	case 4: goto(MauvilleCity_GameCorner_EventScript_CancelTMSelect)
	default: goto(MauvilleCity_GameCorner_EventScript_CancelTMSelect)
    }
	end
    }

script GachaExplainer {
	msgbox("你好！想在扭蛋机上\n碰碰运气吗？最低投入3000枚\l代币，就能得到一只稀有的宝可梦！\p大奖里有非常特别的\n伊布和皮卡丘！千万别错过！\l尽情地赌一把吧！", MSGBOX_NPC)
}
