mapscripts DarkrainInnBedroom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_HIDE_FOLLOWER)
        if(var(VAR_DARKRAI_INN_PROGRESS) == 1) {
            setdynamicwarp(MAP_DARKRAI_INN1, 0)
        } else {
            setdynamicwarp(MAP_DARKRAI_INN1RUINED, 0)
        }
    }
}

script DarkraiInnBedroom_Phone {
    msgbox("一部古董电话。\p电话线似乎没有\n接到任何地方。", MSGBOX_SIGN)
}

script DarkraiInnBedroom_Bed {
    lock
    if (var(VAR_DARKRAI_INN_PROGRESS) == 1) {
        msgbox("光是看着这张床，\n就让人昏昏欲睡。\p也许是时候休息一下，\n闭上眼睛小睡片刻了……")
    msgbox("要小睡一会儿吗？", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox("你是不是忘了什么……？")
        dynmultichoice(20,4,TRUE,4,0,DYN_MULTICHOICE_CB_NONE, "睡吧", "睡吧", "睡吧", "睡吧", "忍住")
        switch (var(VAR_RESULT)) {
            case 0:
            case 1:
            case 2:
            case 3:
                msgbox("大概不是什么\n不能等一会儿的事……")
                applymovement(LOCALID_PLAYER, moves(walk_slow_right, face_down))
                waitmovement
                fadescreenspeed(FADE_TO_BLACK, 24)
                special(DoSoftReset)
                end
            case 4:
                msgbox("你感到一阵寒意，\n决定离床远一点。")
                closemessage
                setvar(VAR_DARKRAI_INN_PROGRESS, 2)
                setdynamicwarp(MAP_DARKRAI_INN1RUINED, 0)
                playmoncry(SPECIES_CRESSELIA, CRY_MODE_NORMAL)
                turnobject(LOCALID_PLAYER, DIR_SOUTH)
                applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
                waitmoncry
                waitmovement(0)
                release
                end
        }
    } else {
        msgbox("你决定离床远一点。")
        closemessage
        setvar(VAR_DARKRAI_INN_PROGRESS, 2)
        setdynamicwarp(MAP_DARKRAI_INN1RUINED, 0)
        playmoncry(SPECIES_CRESSELIA, CRY_MODE_NORMAL)
        turnobject(LOCALID_PLAYER, DIR_SOUTH)
        applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
        waitmoncry
        waitmovement(0)
        release
        end
    }
    } else {
        msgbox("现在可不是睡大觉的时候。")
    }
    release
    end
}