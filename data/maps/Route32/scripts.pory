Route32_Movement_Turnback:
	walk_up
	step_end

Route32_Movement_StartMid:
	walk_left
	step_end

Route32_Movment_StartRight:
	walk_left
	walk_left
	step_end

Route32_Movement_SlowpokeLeft::
	step_end

Route32_Movement_SlowpokeMid::
	walk_right
	step_end

Route32_Movement_SlowpokeRight::
	walk_right
	walk_right
	step_end

Route32_Text_CooltrainerM_WhatsTheHurry:
	.string "等一下！\n这么着急要去哪？$"
	.string ""

Route32_Text_CooltrainerM_AideIsWaiting:
	.string "{PLAYER}，是你吧？\n有个戴眼镜的人\p一直在找你。\p你自己去看看。他正\n在宝可梦中心等你。$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_CooltrainerM_SproutTower:
	.string "你去过喇叭芽之塔了吗？\n只要到了桔梗市，\p大家都会希望你去那里修行。\n这是训练家的基础。\p去喇叭芽之塔吧！$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_CooltrainerM_VioletGym:
	.string "去过宝可梦道馆了吗？\n在那里可以考验你的宝可梦和\p你自己。\n每个训练家都要经历\p这样的考验！$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_CooltrainerM_HaveThisSeed:
	.string "你的宝可梦培养得不错。\n一定是在桔梗市一带\p训练出来的吧。\n道馆里的修行一定\p帮了它们不少忙。\n这是桔梗市的纪念品，请你收下。\p它能增强\n草属性招式的威力。$"
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_CooltrainerM_Experiences:
	.string "你在桔梗市的经历\n会对旅途有帮助的。$"
	.string ""

Route32_Text_SlowpokeTailOffer:
	.string "想不想要这根好吃又\n营养的呆呆兽尾巴？\p现在就卖给你，\n只要¥1,000,000！\p你一定会想要的！$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_ThoughtKidsLoaded:
	.string "切！我还以为\n现在的小孩都有钱呢……$"
	.string ""

Route32_Text_RefusedSlowpokeTail:
	.string "不要？\n那就滚吧。走走走！$"
	.string ""

Route32_Text_FisherJustin_Seen:
	.string "哇！\p你把我那条鱼吓跑了！$"
	.string ""

Route32_Text_FisherJustin_Beaten:
	.string "噗通！$"

Route32_Text_FisherJustin_After:
	.string "不慌不忙……钓鱼\n和对战的精髓是一样的。$"
	.string ""

Route32_Text_FisherRalph1_Seen:
	.string "钓鱼和宝可梦，\n我两样都很在行。\p我可不会输给小鬼！$"
	.string ""
	.string ""

Route32_Text_FisherRalph1_Beaten:
	.string "切！我太急着\n出手了……$"
	.string ""

Route32_Text_FisherRalph1_After:
	.string "钓鱼是我一生的爱好。\p宝可梦是一生的朋友！$"
	.string ""
	.string ""

Route32_Text_FisherHenry_Seen:
	.string "我的宝可梦？\n都是刚抓来的！$"

Route32_Text_FisherHenry_Beaten:
	.string "吧唧？$"

Route32_Text_FisherHenry_After:
	.string "刚抓来的宝可梦，\n赢不了好好培育的。$"
	.string ""

Route32_Text_YoungsterAlbert_Seen:
	.string "以前没见过你啊。\n你觉得自己很强吗？$"
	.string ""

Route32_Text_YoungsterAlbert_Beaten:
	.string "你好强！$"

Route32_Text_YoungsterAlbert_After:
	.string "我要带着自己喜欢的宝可梦，\n努力成为最强。\p我不会像大家那样，\n只用同样的强大宝可梦。$"
	.string ""
	.string ""
	.string ""

Route32_Text_YoungsterGordon_Seen:
	.string "我在草丛里找到\n不错的宝可梦了！\p这次一定能行！$"
	.string ""
	.string ""

Route32_Text_YoungsterGordon_Beaten:
	.string "可恶。我还以为能赢。$"

Route32_Text_YoungsterGordon_After:
	.string "草丛里全是\n缠人的家伙。$"
	.string ""

Route32_Text_CamperRoland_Seen:
	.string "你那眼神……\n真让人在意。$"

Route32_Text_CamperRoland_Beaten:
	.string "嗯……真让人失望。$"

Route32_Text_CamperRoland_After:
	.string "不想对战的话，\n就别和人对上眼。$"
	.string ""

Route32_Text_PicnickerLiz1_Seen:
	.string "嗯嗯。是啊，你听我说……\p什么？对战？我正打电话呢。\n好吧。那就快点。$"
	.string ""
	.string ""

Route32_Text_PicnickerLiz1_Beaten:
	.string "啊！我得消消\n这口气！$"
	.string ""

Route32_Text_PicnickerLiz1_After:
	.string "人家正聊得开心呢。$"

Route32_Text_BirdKeeperPeter_Seen:
	.string "那个徽章！是桔梗市的！\n你打赢阿速了？$"
	.string ""

Route32_Text_BirdKeeperPeter_Beaten:
	.string "我知道自己的弱点在哪。$"

Route32_Text_BirdKeeperPeter_After:
	.string "我该去桔梗市的\n道馆重新修行。$"
	.string ""

Route32_Text_RoarIntro:
	.string "呜嗷嗷嗷！我一吼，人们\n就全跑了！可你却找上门来！\p真让我高兴！这个给你！$"
	.string ""
	.string ""

Route32_Text_RoarOutro:
	.string "呜嗷嗷嗷！是吼叫！\p再厉害的吼叫，\n连宝可梦也会吓跑！$"
	.string ""
	.string ""

Route32_Text_MeetFrieda:
	.string "星琪舞：呀呼！\p我是星期兄弟里的星琪舞！\n请多关照！\p你要是能猜中我最喜欢哪天，\n我就给你奖励。$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_FriedaGivesGift:
	.string "这个毒针送给你！$"

Route32_Text_FriedaGaveGift:
	.string "星琪舞：把它交给会毒属性\n招式的宝可梦吧。\p哦！\p这可厉害了！\p毒属性招式的威力会强得\n让你吓一跳！$"
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_FriedaFriday:
	.string "星琪舞：你好呀！你喜欢\n星期几？\p我最爱星期五。\n绝对没错！\p你不觉得星期五也很棒吗？$"
	.string ""
	.string ""
	.string ""
	.string ""

Route32_Text_FriedaNope:
	.string "星琪舞：不是那个！$"

Route32_Text_Sign1:
	.string "32号道路\p桔梗市——桧皮镇$"
	.string ""

Route32_Text_Sign2:
	.string "阿露福遗迹\n东侧入口$"
	.string ""

Route32_Text_Sign3:
	.string "互连洞\n就在前方$"
	.string ""
`

script Route32HiddenGrottoWarp {
	lock
    msgbox("树丛后面似乎有条小路。\n要进去吗？", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        warp(MAP_HIDDEN_GROTTO_ROUTE32, 0)
		waitstate
    }
    release
    end
}

script Route32RivalGrottoTutorial {
	lock
	createfieldmugshotrival
	msgbox("{PLAYER}！看来你已经\n拿到了第一枚徽章！")
	playbgm(MUS_HG_LYRA, TRUE)
	closemessage
	removefieldmugshot
	moveobjecttocoords(LOCALID_PLAYER, 25, 25, DIR_SOUTH)
	applymovement(LOCALID_ROUTE32_RIVAL, moves(walk_up*5))
	applymovement(LOCALID_ROUTE32_MARILL, moves(walk_up*5, walk_right, walk_up))
	waitmovement(0)
	applymovement(LOCALID_ROUTE32_MARILL, moves(jump_in_place_up))
	playse(SE_LEDGE)
	waitmovement(0)
	applymovement(LOCALID_ROUTE32_MARILL, moves(jump_in_place_up))
	playse(SE_LEDGE)
	waitmovement(0)
	createfieldmugshotrival
	msgbox("连玛力露都想来祝贺你呢！")
	msgbox("听我说，有样东西\n你应该看看。\p是我在这条路上\n探索时发现的。\p跟我来！")
	closemessage
	removefieldmugshot
	applymovement(LOCALID_ROUTE32_RIVAL, moves(walk_left*12, walk_up, face_right))
	applymovement(LOCALID_ROUTE32_MARILL, moves(walk_left*14, walk_up, face_right))
	applymovement(LOCALID_PLAYER, moves(walk_left*11))
	waitmovement(LOCALID_ROUTE32_MARILL)
	createfieldmugshotrival
	msgbox("看到树丛之间这个小缺口了吗？\n那里通向一个隐藏洞穴。\p听说里面有时会有很稀有的\n宝可梦，或是它们掉落的物品。\p既然你是第一次见到，\n这个就让你来探索吧！\p就算今天没能在里面\n找到宝可梦，\l过些日子也该再来看看。")
	msgbox("玛力露和我决定也去\n挑战道馆！\p你要是不想被落下，\n最好从现在开始\l认真特训！\p祝你在下一个道馆\n一切顺利，{PLAYER}！")
	closemessage
	removefieldmugshot
	applymovement(LOCALID_ROUTE32_RIVAL, moves(walk_down))
	applymovement(LOCALID_ROUTE32_MARILL, moves(walk_right, face_down))
	waitmovement
	applymovement(LOCALID_ROUTE32_RIVAL, (moves(walk_down*7)))
	applymovement(LOCALID_ROUTE32_MARILL, (moves(walk_down*4, face_up)))
	waitmovement(0)
	applymovement(LOCALID_ROUTE32_MARILL, moves(jump_in_place_up))
	playse(SE_LEDGE)
	waitmovement(0)
	applymovement(LOCALID_ROUTE32_MARILL, moves(jump_in_place_up))
	playse(SE_LEDGE)
	waitmovement(0)
	applymovement(LOCALID_ROUTE32_MARILL, (moves(walk_fast_down*3)))
	waitmovement(0)
	removeobject(LOCALID_ROUTE32_RIVAL)
	removeobject(LOCALID_ROUTE32_MARILL)
	setflag(FLAG_HIDE_ROUTE32_RIVAL)
	setflag(FLAG_HIDE_NEWBARK_RIVAL)
	setflag(FLAG_HIDE_RIVAL_MARILL)
	setvar(VAR_RIVAL_STATE, 5)
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	release
	end
}
