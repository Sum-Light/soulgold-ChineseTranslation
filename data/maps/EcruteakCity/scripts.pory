EcruteakCity_EventScript_Eevee::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_EEVEE, CRY_MODE_NORMAL
	msgbox EcruteakCity_Text_Eevee, MSGBOX_DEFAULT
	waitmoncry
	release
	end

EcruteakCity_EventScript_Vulpix::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_VULPIX, CRY_MODE_NORMAL
	msgbox EcruteakCity_Text_Vulpix, MSGBOX_DEFAULT
	waitmoncry
	release
	end

EcruteakCity_Text_Eevee:
	.string "伊布：呜咿！$"

EcruteakCity_Text_Vulpix:
	.string "六尾：呜噜噜　吡！$"


EcruteakCity_Text_UnusedMissingDaughter:
	.string "糟了，糟了……\p我女儿不见了。\p不会的……她不会去\n烧焦塔了吧。\p我跟她说过别靠近那里……\p去了那儿的人似乎\n都会失踪……\p唉，我该怎么办才好……？$"
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_Gramps1:
	.string "缘朱市原本有两座塔：\n东边一座，西边一座。$"
	.string ""

EcruteakCity_Text_Gramps2:
	.string "哦，孩子。你也学会像\n和服女孩那样跳舞了吗？\p听说你只要去她们的舞场，\n就会有奇怪的老人\l送你好东西。$"
	.string ""
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_Lass1:
	.string "我要去舞场练习。\n要不要一起来？$"
	.string ""

EcruteakCity_Text_Lass2:
	.string "原来立在这里的那座塔……\p我奶奶说，它以前\n比现在高得多。\p听说现在塔里\n闹鬼。$"
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_Lass2_ReleasedBeasts:
	.string "三只很大的宝可梦朝不同\n方向跑掉了。它们是什么？$"
	.string ""

EcruteakCity_Text_Fisher:
	.string "我听到一个关于浅葱灯塔\n的传闻。\p在那里充当塔灯的宝可梦\n病倒了。看来他们\l遇到了麻烦。$"
	.string ""
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_Fisher_JasmineReturned:
	.string "浅葱灯塔的宝可梦\n已经痊愈了。\p船只在夜里又能\n安全出海了。$"
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_Youngster:
	.string "听说愤怒之湖的宝可梦\n在大闹。我倒想去看一眼。$"
	.string ""

EcruteakCity_Text_Gramps3:
	.string "在遥远的过去……\p这座塔被大火烧毁。三只\n无名的宝可梦葬身其中。\p一只虹色的宝可梦从天而降，\n让它们复活了……\p这是缘朱市历代道馆馆主\n口耳相传的传说。\p我？\p我从前也是训练家哦。\n呵呵呵！$"
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""

EcruteakCity_Text_SageGym:
	.string "道馆馆主松叶现在不在。\n你可以在\l烧焦塔找到他。$"
	.string ""
	.string ""

EcruteakCity_Text_Sign:
	.string "缘朱市\n历史之城\p过去与现在\n在此交汇$"
	.string ""
	.string ""

EcruteakCity_Text_TinTowerSign:
	.string "铃铛塔\p据说有传说的宝可梦\n在此栖息。$"
	.string ""
	.string ""

EcruteakCity_Text_OfficeSign:
	.string "通往铃铛塔的关卡\p无资格者禁止通行。$"
	.string ""

EcruteakCity_Text_GymSign:
	.string "缘朱市宝可梦道馆\n馆主：松叶\p预见未来的神秘修行者$"
	.string ""
	.string ""

EcruteakCity_Text_DanceTheaterSign:
	.string "圆朱舞场$"

EcruteakCity_Text_BurnedTowerSign:
	.string "烧焦塔\p它被一场神秘的大火\n烧毁了。\p此处危险，请勿靠近。$"
	.string ""
	.string ""
	.string ""
`

script EcruteakCity_RivalPostBattle {
	lock
	faceplayer
	createfieldmugshotrival
	msgbox("怎么了，{PLAYER}？\p又在到处刷道馆了？\p还是老样子。你真是\n顺风顺水啊，哇哦。\p我连松叶都还打不过……\p我要去浅葱市修行一阵子。\n别等我了。")
	removefieldmugshot
	closemessage
	moveobjecttocoords(LOCALID_ECRUTEAK_RIVAL, 8, 35, DIR_WEST)
	waitmovement(0)
	delay(60)
	applymovement(LOCALID_ECRUTEAK_RIVAL, moves(face_right))
	delay(30)
	createfieldmugshotrival
	msgbox("……你干得真不错。\n我是说真的。")
	removefieldmugshot
	closemessage
	applymovement(LOCALID_ECRUTEAK_RIVAL, moves(face_left))
	waitmovement(0)
	playse(SE_EXIT)
	delay(30)
	setvar(VAR_RIVAL_STATE, 8)
	setflag(FLAG_HIDE_ECRUTEAK_RIVAL)
	clearflag(FLAG_HIDE_OLIVINE_RIVAL)
	removeobject(LOCALID_ECRUTEAK_RIVAL)
	release
	end
}
