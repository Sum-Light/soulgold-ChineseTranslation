mapscripts Rinto_PoemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_1)
		setrespawn(HEAL_LOCATION_RINTO_VILLAGE_POKEMON_CENTER)
		end
	}
}

script RintoPC_Gbakid1 {
	msgbox("真想和世界各地的朋友们\n一较高下啊。", MSGBOX_NPC)
}

script RintoPC_Battlegirl {
	msgbox("沙尘暴有时\n会让进出这座村庄变得困难。", MSGBOX_NPC)	
}

script RintoPC_Hiker {
	msgbox("听说最近有人在这一带\n看到了模样古怪的\l一对飞行宝可梦。", MSGBOX_NPC)
}

