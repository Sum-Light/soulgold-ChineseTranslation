mapscripts RailwayCave_2F_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_SUS_RAILWAY_DOOR)) {
            setmetatile(73, 10, 0x45A, FALSE)
            setmetatile(73, 9, 0x452, FALSE)
        }
    }
}

raw `
RailwayCave_BrailleRegisteel:
	.string "杖影随尾舞，\n"
	.string "尾振百鳞鸣。\l"
	.string "鳞声如金铁，\l"
	.string "甲坚护其身。\l"
	.string "龙吟震四方。$"
`

script RailwayCave_SusDoor {
    lock
    msgbox("门上刻着什么……")
    closemessage
    msgbox(RailwayCave_BrailleRegisteel, MSGBOX_DEFAULT)
    closemessage
    checkspecies(SPECIES_KOMMO_O)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_SUS_RAILWAY_DOOR)
        setmetatile(73, 10, 0x45A, FALSE)
        setmetatile(73, 9, 0x452, FALSE)
        playse(SE_EXIT)
        special(DrawWholeMapView)
    }
    release
    end
}

script RailwayCave_TrainerBob {
        trainerbattle_single(TRAINER_RAILWAYBOB, "你知道吗？地鼠和三地鼠\n帮我们挖了这些隧道。",
                                            "你知道吗？可即便如此，\n也花了好多年才完成！")
        msgbox("你知道吗？这里的岩壁\n比普通的山岩硬多了。\l里面混了很多金属，\l挖起来特别费时间。", MSGBOX_AUTOCLOSE)
}

script RailwayCave_TrainerMason {
        trainerbattle_single(TRAINER_RAILWAYMASON, "哇！有东西咬住我的脚了！",
                                            "哦，原来是我的泥巴鱼！")
        msgbox("泥巴鱼喜欢钻到这里的\n地下。它们似乎很中意\l这儿的气氛。", MSGBOX_AUTOCLOSE)
}

script RailwayCave_TrainerYoda {
    trainerbattle_single(TRAINER_RAILWAYYODA, "哈！空气里流动的电流，\n对我的肌肉很有好处！",
                                            "我们还得继续锻炼！")
        msgbox("这里流动的电流，对长时间\n锻炼后的肌肉放松\l很有好处！", MSGBOX_AUTOCLOSE)
}

script RailwayCave_TrainerSanada {
    trainerbattle_single(TRAINER_RAILWAYSANADA, "这里是铁轨的维护隧道，\n你到底是怎么进来的？",
                                            "我要把这事报告给上级！")
        msgbox("就算你能带着宝可梦\n闯进任何地方，\l也不代表你就可以这么做！", MSGBOX_AUTOCLOSE)
}