mapscripts SnowtopMountain_B1F_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_SNOWTOP_REGICE_DOOR)) {
            setmetatile(5, 36, 0x414, FALSE)
            setmetatile(5, 35, 0x40C, FALSE)
        }
    }
}

raw `
Snowtopmountain_BrailleRegice:
	.string "戟刃凝冰指苍穹，\n"
	.string "脊上长锋映雪峰。\l"
	.string "龙已进化至终形。$"
`

script B1F_Snowtopmountain_Bearnese {
    trainerbattle_single(TRAINER_BEARNESE, "快看，我呼出的气都\n结成冰柱了！", 
                                         "感觉有点冷啊。")
    msgbox("听说古代冰属性宝可梦\n就沉睡在这座山里的\l某处。到底在哪儿呢？", MSGBOX_AUTOCLOSE)
}

script B1F_Snowtopmountain_Susdoor {
    lock
    msgbox("墙上刻着什么……")
    closemessage
    msgbox(Snowtopmountain_BrailleRegice, MSGBOX_DEFAULT)
    closemessage
    checkspecies(SPECIES_BAXCALIBUR)
    if (var(VAR_RESULT) == TRUE) {
        setflag(FLAG_SNOWTOP_REGICE_DOOR)
        setmetatile(5, 36, 0x414, FALSE)
        setmetatile(5, 35, 0x40C, FALSE)
        playse(SE_EXIT)
        special(DrawWholeMapView)
    }
    release
    end
}