mapscripts Kitakami_Temple_BattleRoom_MapScripts {}

script BattleRoom_Audino {
    lock
    faceplayer
    playmoncry(SPECIES_AUDINO, CRY_MODE_NORMAL)
    msgbox("差不多娃娃：嗷呜！")
    waitmoncry
    release
    end
}

script BattleRoom_Machamp {
    lock
    playmoncry(SPECIES_MACHAMP, CRY_MODE_NORMAL)
    msgbox("怪力：哼哈！")
    waitmoncry
    release
    end
}

script BattleRoom_Mienshao {
    lock
    playmoncry(SPECIES_MIENSHAO, CRY_MODE_NORMAL)
    msgbox("师父鼬：咪！")
    waitmoncry
    release
    end
}

script BattleRoom_BattleGirl {
    lock
    msgbox("师父鼬，用飞膝踢！")
    playmoncry(SPECIES_MIENSHAO, CRY_MODE_NORMAL)
    applymovement(LOCALID_KITAKAMI_MIENSHAO, moves(jump_in_place_left*2))
    waitmovement(0)
    waitmoncry
    release
    end
}

script BattleRoom_BlackBelt {
    lock
    msgbox("怪力，用守住挡下来！")
    playmoncry(SPECIES_MACHAMP, CRY_MODE_NORMAL)
    applymovement(LOCALID_KITAKAMI_MACHAMP, moves(jump_in_place_right*2))
    waitmovement(0)
    waitmoncry
    release
    end
}

script BattleRoom_MoneyTrainer {
    lock
    faceplayer
    if (flag(FLAG_TEMP_1) == FALSE) {
        msgbox("您好，我们为来访者\n提供付费训练服务。\p这笔钱将用于资助寺院\n和村子。有意向吗？")
        setflag(FLAG_TEMP_1)   
    }
    showmoneybox(0,0)
    msgbox("只要¥10,000，就能和\n差不多娃娃、幸福蛋一起训练。", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        checkmoney(10000)
        if (var(VAR_RESULT) == FALSE) {
            msgbox("哎呀，看来您现在\n手头不太宽裕。\p请筹到钱后再来。")
            hidemoneybox
            release
            end
        }
        removemoney(10000)
        updatemoneybox(0)
        playse(SE_SHOP)
        waitse
        hidemoneybox
        msgbox("谢谢，我们开始吧。")
        trainerbattle_no_intro(TRAINER_DOJO_AUDINO, "感谢您的资助。")
        msgbox("想再训练的话，欢迎再来。")
    } else {
        hidemoneybox
        msgbox("好的，没关系。")
        release
        end
    }
    release
    end
}