script BattleCafe_ConfirmRewardMon {
    if (var(VAR_BATTLE_CAFE_POINTS) < 5) {
        goto(BattleCafe_NotEnoughPoints)
    }
    bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
    msgbox("用5点咖啡馆点数\n兑换{STR_VAR_1}吗？", MSGBOX_YESNO)
    if (var(VAR_RESULT) != YES) {
        goto(BattleCafe_RewardMenu)
    }

    if (var(VAR_TEMP_B) >= 3 && var(VAR_TEMP_B) <= 6 && checkitem(ITEM_REVEAL_GLASS) == FALSE) {
        checkitemspace(ITEM_REVEAL_GLASS, 1)
        if (var(VAR_RESULT) == FALSE) {
            goto(BattleCafe_NotEnoughBagSpace)
        }
    }

    givemon(VAR_TEMP_TRANSFERRED_SPECIES, 70)
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        goto(Common_EventScript_NoMoreRoomForPokemon)
    }
    showgivemonpic(10, 3)
    call(Common_EventScript_GiftMon)
    hidemonpic
    subvar(VAR_BATTLE_CAFE_POINTS, 5)
    switch (var(VAR_TEMP_B)) {
        case 0: setflag(FLAG_BATTLE_CAFE_ARTICUNO_RECEIVED)
        case 1: setflag(FLAG_BATTLE_CAFE_ZAPDOS_RECEIVED)
        case 2: setflag(FLAG_BATTLE_CAFE_MOLTRES_RECEIVED)
        case 3: setflag(FLAG_BATTLE_CAFE_TORNADUS_RECEIVED)
        case 4: setflag(FLAG_BATTLE_CAFE_THUNDURUS_RECEIVED)
        case 5: setflag(FLAG_BATTLE_CAFE_LANDORUS_RECEIVED)
        case 6: setflag(FLAG_BATTLE_CAFE_ENAMORUS_RECEIVED)
        case 7: setflag(FLAG_BATTLE_CAFE_TAPU_KOKO_RECEIVED)
        case 8: setflag(FLAG_BATTLE_CAFE_TAPU_LELE_RECEIVED)
        case 9: setflag(FLAG_BATTLE_CAFE_TAPU_BULU_RECEIVED)
        case 10: setflag(FLAG_BATTLE_CAFE_TAPU_FINI_RECEIVED)
    }
    special(Achievement_CheckAll)
    if (var(VAR_TEMP_B) >= 3 && var(VAR_TEMP_B) <= 6) {
        if (checkitem(ITEM_REVEAL_GLASS) == FALSE) {
            msgbox("这个也许对您有用。")
            giveitem(ITEM_REVEAL_GLASS)
        }
    }
    msgbox("很划算的交易。它一定会\n和您的队伍很合拍。")
    goto(BattleCafe_RewardMenu)
}

