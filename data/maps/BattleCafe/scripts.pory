}

script BattleCafe_Goodbye {
    msgbox("欢迎再回来，带着再战的胃口！")
    release
    end
}

script BattleCafe_GiveDailyCandyReward {
    random(3)
    addvar(VAR_RESULT, 1)
    giveitem(ITEM_EXP_CANDY_XL, VAR_RESULT)
    return
}

script BattleCafe_TrainerAthena {
    lock
    faceplayer
    
    if (flag(FLAG_DAILY_BATTLE_CAFE_ATHENA)) {
        msgbox("玩得开心吗？明天我们再\n打一场吧！")
        release
        end
    }
    msgbox("看看你能不能扛住我这套\n消耗战术！")
    trainerbattle_no_intro(TRAINER_CAFE_ATHENA, "咦？")
    setflag(FLAG_DAILY_BATTLE_CAFE_ATHENA)
    msgbox("玩得开心吗？")
    call(BattleCafe_GiveDailyCandyReward)
    release
    end
}

script BattleCafe_TrainerDoves {
    lock
    faceplayer
    
    if (flag(FLAG_DAILY_BATTLE_CAFE_DOVES)) {
        msgbox("多夫斯：等明天我的盖诺赛克特\n能上场了，我们再打一场。")
        release
        end
    }
    msgbox("多夫斯：让你见识一下\n盖诺赛克特的实力！")
    trainerbattle_no_intro(TRAINER_CAFE_DOVES, "又因为太强被禁赛了……")
    setflag(FLAG_DAILY_BATTLE_CAFE_DOVES)
    msgbox("多夫斯：等明天我的盖诺赛克特\n能上场了，我们再打一场。")
    call(BattleCafe_GiveDailyCandyReward)
    release
    end
}

