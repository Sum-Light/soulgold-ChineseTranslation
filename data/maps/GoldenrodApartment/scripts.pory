mapscripts GoldenrodApartment_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_MAGERNA_DOOR_OPENED)) {
            setmetatile(62, 8, 0x401, FALSE)
        }
    }
}

script GoldenrodApartments_BasementGuard {
    msgbox("抱歉，这道楼梯通往\n公寓的储藏室。再说，\l我想也不会有哪个训练家\l会想去看那些因为过度消费\l而被丢在这里的\l旧家电吧。")
    checkspecies(SPECIES_ROTOM)
    if (var(VAR_RESULT) == FALSE) {
        release
        end
    }
    msgbox("……什么？你的洛托姆\n想去看看那些家电？好吧……\l反正住客也不会\l再用它们了。要是有人问起，\l我们就当没见过。我要去\l喝杯咖啡歇歇了。")
    closemessage
    setflag(FLAG_HIDE_GROD_APARTMENTS_GUARD)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_APARTMENT_GUARD)
    delay(60)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
} 

script GoldenrodApartments_OldLady {
    msgbox("这几年这座城市\n一直在不断扩张。\l我真怕自己被这飞速的\l变化甩在了后头。", MSGBOX_NPC)
}

script GoldenrodApartments_Child {
    msgbox("妈妈总是很晚才回家……", MSGBOX_NPC)
}

script GoldenrodApartments_Girl {
    msgbox("我们妈妈在播音塔工作，\n所以总是很忙。还好\l有妈妈的斗笠菇帮忙\l料理一切！", MSGBOX_NPC)
}

script GoldenrodApartments_Breloom {
    lock
    playmoncry(SPECIES_BRELOOM, CRY_MODE_NORMAL)
    waitmoncry
    msgbox("斗笠菇正开开心心地洗着碗！")
    waitmessage
    release
    end
}

script GoldenrodApartments_Gameboykid {
    msgbox("这上面那层楼\n总会传来奇怪的声音。\l可我从来没见过\l住在那里的人，真奇怪。", MSGBOX_NPC)
}

script GoldenrodApartments_ScientistF {
    msgbox("满金市最近邀请了\n其他地区的研究员\l到播音塔开商务会议。", MSGBOX_NPC)
}

script GoldenrodApartments_ScientistM {
    msgbox("这些天空民宿公寓\n只勉强配有最基本的\l工具……真让人烦心。", MSGBOX_NPC)
}

script GoldenrodApartments_LockedDoor {
    lock
    if (flag(FLAG_MAGERNA_DOOR_OPENED)) {
        msgbox("门已经开了。")
        release
        end
    }
    if (flag(FLAG_GOT_MAGERNA_KEY)) {
        msgbox("前路似乎被一道金属门\n挡住了。能看见一个小锁孔。\p你使用了公寓钥匙。")
        closemessage
        playse(SE_UNLOCK)
        setmetatile(62, 8, 0x401, FALSE)
        special(DrawWholeMapView)
        setflag(FLAG_MAGERNA_DOOR_OPENED)
        waitse
        setflag(FLAG_HIDE_MAGERNA_POLICE)
        removeobject(LOCALID_M_POLICE1)
        removeobject(LOCALID_M_POLICE2)
        msgbox("路已经通了。")
        release
        end
    }
    msgbox("前路被一道金属门\n挡住了。能看见一个小锁孔，\l可你身上没有能配上的东西。")
    release
    end
}

script GoldenrodApartments_Apartment1 {
    msgbox("满金天空公寓1楼", MSGBOX_SIGN)
}

script GoldenrodApartments_Apartment2 {
    msgbox("满金天空公寓2楼", MSGBOX_SIGN)
}

script GoldenrodApartments_Apartment3 {
    msgbox("满金天空公寓3楼", MSGBOX_SIGN)
}

// For refight after hall of fame reset
script MagearnaEncounter {
    lock
    faceplayer
    bosslegendaryencounterwithmoves(SPECIES_MAGEARNA, 
                                    75, 
                                    LOCALID_MAGEARNA, 
                                    FLAG_HIDE_MAGEARNA, 
                                    4, 
                                    SPECIES_NONE, 
                                    110, 
                                    MOVE_SHIFT_GEAR, 
                                    MOVE_CALM_MIND, 
                                    MOVE_DRAINING_KISS, 
                                    MOVE_STORED_POWER)
    release
    end
}

script MadScientistEvent {
    lock
    msgbox("你感到这个方向有麻烦。")
    msgbox("你准备好继续往前了吗？", MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        applymovement(LOCALID_PLAYER, moves(walk_right))
        waitmovement(0)
        release
        end
    }
    closemessage
    moveobjecttocoords(LOCALID_PLAYER, 53, 14, DIR_NORTH)
    waitmovement(0)
    delay(15)
    playbgm(MUS_HG_TEAM_ROCKET_HQ, FALSE)
    applymovement(LOCALID_MADSC, moves(walk_in_place_up))
    waitmovement(0)
    msgbox("科学家：哈哈！机器就快\n完成了！\p我要向那些夺走我\n研究经费的火箭队干部\l报仇！")
    playse(SE_LEDGE)
    applymovement(LOCALID_MADSC, moves(jump_in_place_up))
    playse(SE_LEDGE)
    applymovement(LOCALID_MADSC, moves(jump_in_place_up))
    waitmovement
    msgbox("科学家：还有！还有那些\n自以为是的科学委员会成员！\p这将是我的究极之作！\n啊哈哈哈哈哈哈哈哈——！")
    msgbox("首先……")
    delay(30)
    turnobject(LOCALID_MADSC, DIR_SOUTH)
    msgbox("科学家：你是谁？\n你是怎么进来的？！")
    msgbox("我没空搭理\n讨债的，也没空搭理推销员！\p我这就把你打发走！")
    closemessage
    applymovement(LOCALID_MADSC, moves(walk_down))
    waitmovement(0)
    trainerbattle_no_intro(TRAINER_MAD_SCIENTIST, "不！这我可付不起！")
    applymovement(LOCALID_MADSC, moves(walk_in_place_down))
    msgbox("科学家：看来这次税务局\n派来了个硬茬子。\p不过没关系！\p我正想找志愿者呢，\n这反倒正好！\p就让你第一个见识\n我这只机械宝可梦的\l真正力量！")
    closemessage
    applymovement(LOCALID_MADSC, moves(walk_right, face_up))
    waitmovement(0)
    msgbox("科学家：玛机雅娜！\n消灭这个愚蠢的闯入者！")
    closemessage
    playmoncry(SPECIES_MAGEARNA, CRY_MODE_NORMAL)
    waitmoncry
    applymovement(LOCALID_MAGEARNA, moves(walk_down, delay_16, walk_down))
    waitmovement(0)
    applymovement(LOCALID_MADSC, moves(face_left))
    waitmovement(0)
    bosslegendaryencounterwithmoves(SPECIES_MAGEARNA, 
                                    75, 
                                    LOCALID_MAGEARNA, 
                                    FLAG_HIDE_MAGEARNA, 
                                    4, 
                                    SPECIES_NONE, 
                                    110, 
                                    MOVE_SHIFT_GEAR, 
                                    MOVE_CALM_MIND, 
                                    MOVE_DRAINING_KISS, 
                                    MOVE_STORED_POWER)
    playbgm(MUS_HG_TEAM_ROCKET_HQ, FALSE)
    msgbox("科学家：这……这不可能！\p我的作品……没了？就这样没了？\p它本该是无敌的！\p这还没完！我还能——")
    msgbox("？？？：站住别动！")
    closemessage
    playse(SE_PIN)
    applymovement(LOCALID_MADSC, Common_Movement_ExclamationMark)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    turnobject(LOCALID_MADSC, DIR_SOUTH)
    waitse
    clearflag(FLAG_HIDE_MAGERNA_POLICE)
    addobject(LOCALID_M_POLICE1)
    addobject(LOCALID_M_POLICE2)
    applymovement(LOCALID_M_POLICE1, moves(walk_up*5, walk_left*5, walk_up))
    applymovement(LOCALID_M_POLICE2, moves(walk_left, walk_up*5, walk_left*4, walk_up*2, face_left))
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    msgbox("警察：你因逃税、与火箭队\n有牵连，以及开发非法宝可梦\l而被捕了。")
    applymovement(LOCALID_MADSC, moves(walk_in_place_down))
    waitmovement(0)
    msgbox("科学家：可、可我是\n被火箭队抛弃的人啊！\p我是无辜的！我只是想\n证明他们错了！")
    applymovement(LOCALID_M_POLICE2, moves(walk_in_place_left))
    waitmovement
    msgbox("留着去跟法官说吧。")
    turnobject(LOCALID_M_POLICE1, DIR_WEST)
    fadedefaultbgm
    msgbox("警察：谢谢你帮忙\n制服了这个坏家伙。\p他躲在这里好一阵子了，\n到处惹是生非。\p只要你守口如瓶，\n那只宝可梦就归你了。\p我们相信你会好好\n照顾它的。")
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_MADSC)
    removeobject(LOCALID_M_POLICE1)
    removeobject(LOCALID_M_POLICE2)
    setflag(FLAG_HIDE_MAGERNA_POLICE)
    setflag(FLAG_HIDE_MAD_SCIENTIST)
    delay(45)
    fadescreen(FADE_FROM_BLACK)
    setvar(VAR_MAD_SCIENTIST_EVENT_STATE, 1)
    release
    end
}