mapscripts DarkraiInn1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_TEMP_HIDE_FOLLOWER)
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_OPEN_INN_DOOR)) {
            setmetatile(24, 3, 0x03C, FALSE)
            setmetatile(24, 2, 0x034, FALSE)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DARKRAI_INN_PROGRESS, 0 
        {
            lock
            msgbox("欢迎光临，尊贵的客人！")
            closemessage
            moveobjecttocoords(LOCALID_PLAYER, 28, 15, DIR_NORTH)
            waitmovement(0)
            msgbox("您肯光临我们这家小旅馆，\n真是我们的荣幸。\p这是您房间的钥匙。")
            playfanfare(MUS_HG_OBTAIN_ITEM)
            msgbox("{PLAYER}得到了月亮钥匙！")
            waitfanfare
            msgbox("您的房间是404号，\n从左边楼梯上去，\l就在正前方。")
            msgbox("祝您入住愉快。")
            setvar(VAR_DARKRAI_INN_PROGRESS, 1)
            release
            end
        }
    ]
}

script Inn_Door404 {
    lock
    if (flag(FLAG_OPEN_INN_DOOR)) {
        msgbox("您房间的门已经打开了。")
        release
        end
    } else {
        msgbox("404号房\p你用钥匙打开了房门，\n可钥匙却卡在了\l锁孔里。")
        setmetatile(24, 3, 0x03C, FALSE)
        setmetatile(24, 2, 0x034, FALSE)
        playse(SE_EXIT)
        special(DrawWholeMapView)
        setflag(FLAG_OPEN_INN_DOOR)
        release
        end
    }
    release
    end
}

script Inn_Keeper {
    msgbox("希望您在我们旅馆\n安安稳稳地休息。", MSGBOX_NPC)
}

script Inn_AnimalHead {
    msgbox("一只宝可梦头部的\n填充标本。\p……\p总觉得那双眼睛\n在盯着你。", MSGBOX_NPC)
}

script Inn_LockedDoor {
    msgbox("你试着开门，\n但门好像锁着。", MSGBOX_NPC)
}

script FoggyWindow_Inn {
    msgbox("你朝窗外望去……\p一层浓雾好像遮住了\n你的视线。", MSGBOX_NPC)
}

script Inn_OrnatePiano {
    msgbox("你面前放着一架华丽的钢琴。\n看起来保养得很好。", MSGBOX_SIGN)
}

script Inn_Drums {
    msgbox("看起来崭新的架子鼓。真帅！", MSGBOX_SIGN)
}

script Inn_LockedSafe {
    msgbox("一个上锁的保险箱，\n不知道里面装着什么。", MSGBOX_SIGN)
}

script Inn_NoteOnWall {
    msgbox("好像是一张关于旅馆\n停业的通知。真奇怪……", MSGBOX_SIGN)
}

script Inn_PapersOnWall {
    msgbox("墙上贴满了各种便条，\n字迹模糊，难以辨认。", MSGBOX_SIGN)
}

script Inn_TryingToExit {
    lock
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    msgbox("你才刚到，\n没理由这就走吧……")
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement
    release
    end
}

script Inn_ReceptionPhone {
    msgbox("这大概是用来呼叫\n住客的吧。", MSGBOX_SIGN)
}