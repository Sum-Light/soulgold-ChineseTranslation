BattleFrontier_BattleTowerBattleRoom_EventScript_RecordBrainWin::
	call BattleFrontier_EventScript_IncrementWinStreak
	tower_setbattlewon
	return

`

script BattleFrontier_BattleTowerBattleRoom_EventScript_ReadyForOpponent {
    tower_get(TOWER_DATA_WIN_STREAK)
    copyvar(VAR_BATTLE_TOWER_STREAK, VAR_RESULT)
	addvar(VAR_RESULT, 1)
    buffernumberstring(STR_VAR_1, VAR_RESULT)
    msgbox("您将面对第{STR_VAR_1}位对手。\n准备好了吗？")
}
	
