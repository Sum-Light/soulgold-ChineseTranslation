mapscripts BattleFactoryGrounds_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
         goto(setFactoryFlightFlag)
    }
}

script setFactoryFlightFlag {
    setflag(FLAG_VISITED_BATTLE_FACTORY)
    end
}

script FactoryGrounds_CooltrainerF {
    msgbox("对战工厂的对战可是很艰难的！\p不能用自己的宝可梦，\n所以必须随机应变。", MSGBOX_NPC)
}

script FactoryGrounds_Fisher {
    lock
    msgbox("唔，这个池塘里没有鲤鱼王，\n只有麻麻小鱼和灯笼鱼……")
    release
    end
}

script FactoryGrounds_Boy {
    lock
    faceplayer
    msgbox("我和妙喵不用开口\n就能交流！看好了！")
    applymovement(LOCALID_FACTORY_ESPURR, moves(face_right))
    waitmovement
    applymovement(LOCALID_FACTORY_KID, moves(face_left))
    waitmovement
    msgbox("...")
    delay(30)
    msgbox("...")
    faceplayer
    msgbox("很厉害吧？")
    release
    end
}

script FactoryGrounds_Espurr {
    lock
    faceplayer
    playmoncry(SPECIES_ESPURR, CRY_MODE_NORMAL)
    msgbox("妙喵：嘶——！")
    waitmoncry
    release
    end
}

script FactoryGrounds_OldLady {
    msgbox("我不太喜欢这些新式建筑\n盖得离我们心爱的\l缘朱市这么近。", MSGBOX_NPC)
}