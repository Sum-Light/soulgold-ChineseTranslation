mapscripts Kitakami_Temple_MapScripts {}

script megaKickTrainer {
    lock
    msgbox(format("不对不对，你不明白，\n百万吨重拳才是更强的招式！"))
    release
    end
}

script megaPunchTrainer {
    lock
    msgbox(format("蠢货！谁都知道\n百万吨重踢才是力量的象征！"))
    release
    end
}

script DojoTourist {
    lock
    faceplayer
    msgbox("这里的传统历经无数代传承，\n至今仍延续不绝。\p真是令人敬佩！")
    release
    end
}

script DojoTrainee {
    lock
    faceplayer
    msgbox("我们也为来访者提供付费课程。\p若您想早日变强，\n还请资助本寺。")
    release
    end
}

script DojoTeacher {
    lock
    faceplayer
    msgbox("我身后是练习室。\p请留神，不要打扰\n他们修行。")
    release
    end
}

script DojoTeacher2 {
    msgbox("这些门通往\n休息的厢房。", MSGBOX_NPC)
}