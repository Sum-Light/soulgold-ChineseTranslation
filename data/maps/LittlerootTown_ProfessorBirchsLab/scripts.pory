`

script PasswordMachine {
    lock
    msgbox("这是一台用于研究的机器。\p“现实移位机，\n请小心使用！”\p你注意到机器上有个小小的\n文字输入框，正等待输入。")
    special(EnterCode)
    waitstate
    special(GetCodeFeedback)
    msgbox("你感觉什么东西移位了……\n也许只是错觉！\p谁知道呢！")
    closemessage
    release
    end
}