mapscripts Kitakami_Temple_TrainingRoom_MapScripts {}

script dojoFexpert {
    lock
    faceplayer
    msgbox("锻炼身心与锻炼宝可梦\n同样重要。\p身心柔弱，就无法\n面对艰难的挑战。")
    if (!flag(FLAG_RECEIVED_FOCUS_SASH)) {
        msgbox(format("这个或许能帮您集中精神修行。"))
        giveitem(ITEM_FOCUS_SASH)
        setflag(FLAG_RECEIVED_FOCUS_SASH)
    }
    release
    end
}

script dojoTrainer {
    lock
    msgbox("弟子正在打坐，\n打扰他未免失礼。")
    closemessage
    release
    end
}

