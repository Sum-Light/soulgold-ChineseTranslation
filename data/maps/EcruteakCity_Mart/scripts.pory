raw `
EcruteakCity_Mart_MapScripts::
	.byte 0

EcruteakCity_Mart_EventScript_Nerd::
	lock
	faceplayer
	msgbox EcruteakMart_Text_SuperNerd, MSGBOX_DEFAULT
	closemessage
	release
	end

EcruteakCity_Mart_EventScript_Granny::
	lock
	faceplayer
	msgbox EcruteakMart_Text_Granny, MSGBOX_DEFAULT
	closemessage
	release
	end

EcruteakMart_Text_SuperNerd:
	.string "我的伊布进化成了\n太阳伊布。\p可是朋友的伊布\n却进化成了月亮伊布。\p明明都是用同样的方法\n养大的……为什么？$"
	.string ""
	.string ""
	.string ""
	.string ""

EcruteakMart_Text_Granny:
	.string "给濒死的宝可梦用活力碎片，\n它马上就会醒过来哦。$"
	.string ""
`

script Ecruteak_Mart2 {
    lock
    faceplayer
    message("欢迎光临！有什么可以帮您？")
    waitmessage
    pokemart(Ecruteak2)
    msgbox("欢迎再来！")
    release
    end
}

mart Ecruteak2 {
	ITEM_TM_SNARL
	ITEM_TM_TRAILBLAZE
	ITEM_TM_TRICK_ROOM
	ITEM_TM_WILL_O_WISP
    ITEM_QUICK_BALL
    ITEM_NET_BALL
    ITEM_TIMER_BALL
}