mapscripts Route50_MapScripts {}

script Route50_TrainerRowan {
	trainerbattle_single(TRAINER_ROUTE50_ROWAN, "让我看看你还有没有\n力气来对付我！", 
												 "你一步都没踏错！")
	msgbox("愤怒之湖离这儿不远。\n这一带气候说变就变。", MSGBOX_AUTOCLOSE)
	end
}

script Route50_TrainerCaspian {
	trainerbattle_double(TRAINER_ROUTE50_CASPIAN, "我正在把所有的道路\n都巡游一遍！", "你也许是我遇到过的\n最强的训练家。", "带上两只宝可梦来对战！")
	msgbox("你有在利用天气吗？\n天气能在一瞬间\l扭转战局。", MSGBOX_AUTOCLOSE)
	end
}

script Route50_TrainerIgnis {
	trainerbattle_single(TRAINER_ROUTE50_IGNIS, "这地方练喷火\n再合适不过了！", "不！我的火焰！")
	msgbox("在这儿不会不小心\n把什么东西点着。", MSGBOX_AUTOCLOSE)
	end
}

script Route50_Virizion {
	lock
	faceplayer
	bosslegendaryencounter(SPECIES_VIRIZION, 80, LOCALID_VIRIZION, FLAG_HIDE_VIRIZION, 2, SPECIES_NONE, 110)
	release
	end
}

script Route50_ObservingWoman {
	lock
	if (!flag(FLAG_HIDE_VIRIZION)) {
		msgbox("那边那个东西\n是什么宝可梦？")
		release
		end
	}
	msgbox("哦，你抓住那家伙了！干得好！")
	release
	end
}

script Route50CafeSign {
	msgbox("对战咖啡馆\n欢迎所有挑战者！", MSGBOX_SIGN)
}