mapscripts AbandonedRocketHideout_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_ARH_PUZZLE1)) {
            setmetatile(17, 10, 0x500, FALSE)
            setmetatile(18, 10, 0x500, FALSE)
            setmetatile(19, 10, 0x500, FALSE)
            setmetatile(17, 11, 0x500, FALSE)
            setmetatile(18, 11, 0x500, FALSE)
            setmetatile(19, 11, 0x500, FALSE)
        }
        if (flag(FLAG_ARH_PUZZLE3)) {
            setmetatile(10, 10, 0x500, FALSE)
            setmetatile(11, 10, 0x500, FALSE)
            setmetatile(12, 10, 0x500, FALSE)
            setmetatile(10, 11, 0x500, FALSE)
            setmetatile(11, 11, 0x500, FALSE)
            setmetatile(12, 11, 0x500, FALSE)
        }
    }
}

script ARH_Note1 {
    msgbox("尘土下压着一张\n脆弱的便条……\p黑暗计划——关闭命令\p所有黑暗实验体\n即刻废弃。\p烧毁研究成果。\p不留痕迹。", MSGBOX_SIGN)
}

script ARH_MiddleDoor {
    if (flag(FLAG_ARH_PUZZLE3)) {
        msgbox("中央的卷帘门已经打开了。", MSGBOX_SIGN)
    } else {
        msgbox("中央档案室\p未检测到电力继电器\p卷帘门锁死了。", MSGBOX_SIGN)
    }
}

script ARH_RightDoor {
    if (flag(FLAG_ARH_PUZZLE1)) {
        msgbox("R号仓储区\p已获准进入", MSGBOX_SIGN)
    } else {
        msgbox("R号仓储区\p已由黑暗协议封锁\p需要远程授权。", MSGBOX_SIGN)
    }
}

script ARH_Note2 {
    msgbox("报告已被粉碎，\n只剩一段文字……\p“戴鲁比是首个\n保持稳定黑暗反应的\l实验体。\p此前的小拉达和超音蝠\n实验体被判定为不可用。”", MSGBOX_SIGN)
}

script ARH_Computer1 {
    lock
    if (flag(FLAG_ARH_PUZZLE1)) {
        msgbox("终端显示着一行字：\pR号仓储区——已解封", MSGBOX_SIGN)
        release
        end
    }
    playse(SE_PC_ON)
    msgbox("旧终端断断续续地启动了。\p黑暗保险机制\n请输入首个可用\l实验体的图鉴编号。")
    waitse
    dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE,
                   "019", "041", "198", "228", "取消")
    switch (var(VAR_RESULT)) {
        case 3:
            playse(SE_SUCCESS)

            msgbox("实验体228：戴鲁比\n授权已确认\pR号仓储区已解封。")
            setflag(FLAG_ARH_PUZZLE1)
            setmetatile(17, 10, 0x500, FALSE)
            setmetatile(18, 10, 0x500, FALSE)
            setmetatile(19, 10, 0x500, FALSE)
            setmetatile(17, 11, 0x500, FALSE)
            setmetatile(18, 11, 0x500, FALSE)
            setmetatile(19, 11, 0x500, FALSE)
            playse(SE_EXIT)
            special(DrawWholeMapView)
        case 4:
            playse(SE_PC_OFF)
        default:
            playse(SE_FAILURE)

            msgbox("实验体记录遭到拒绝。")
            
    }
    release
}

script ARH_BoxLeft {
    msgbox("箱子内衬与箱壁之间\n卡着一块写字板。\p实验体索引\n019——小拉达\l041——超音蝠\l198——黑暗鸦\l228——戴鲁比", MSGBOX_SIGN)
}

script ARH_BoxRight1 {
    msgbox("箱子里有一件火箭队制服，\n还有一张用红墨水写的便条……\p“我的寄存柜密码是041。\n马尔科夫，这次别碰。”", MSGBOX_SIGN)
}


script ARH_BoxRightRoomRightOne2 {
    if (flag(FLAG_ARH_PUZZLE2)) {
        msgbox("隔层是空的。", MSGBOX_SIGN)
        end
    }

    lock
    msgbox("假底下面有\n沉重的东西挪动了一下。")
    playfanfare(MUS_HG_OBTAIN_ITEM)
    msgbox("{PLAYER}找到了磁力继电器！\p这东西好像是装在\n仓库里某台机器上的。")
    waitfanfare
    setflag(FLAG_ARH_PUZZLE2)
    release
}

script ARH_BoxWrong {
    random(6)
    switch (var(VAR_RESULT)) {
        case 0:
            msgbox("只剩压扁的精灵球\n碎壳。每一个都被\l盖上了“不合格”的印章。", MSGBOX_SIGN)
        case 1:
            msgbox("数百只左手用的\n黑色手套。\p没有一只是右手的。", MSGBOX_SIGN)
        case 2:
            msgbox("一张出货单上写着：\p邪恶披风——40\n戏剧效果鼓风机——40", MSGBOX_SIGN)
        case 3:
            msgbox("包装纸上粘着一块\n石化了的愤怒馒头。", MSGBOX_SIGN)
        case 4:
            msgbox("箱子里塞满了假胡子，\n标签上写着“干部应急包”。", MSGBOX_SIGN)
        case 5:
            msgbox("箱子上写着\n“大量霹雳电球”。\p里面是空的……\p你松了一口气。", MSGBOX_SIGN)
    }
}

script ARH_MachineRight {
    if (flag(FLAG_ARH_PUZZLE3)) {
        msgbox("恢复运转的继电器\n平稳地嗡鸣着。\p中央档案室——通道已启用", MSGBOX_SIGN)
        end
    }
    if (!flag(FLAG_ARH_PUZZLE2)) {
        msgbox("中央卷帘门控制\p错误：未检测到磁力继电器\p继电器形状的插槽是空的。", MSGBOX_SIGN)
        end
    }

    lock
    msgbox("磁力继电器正好\n嵌进空插槽里。")
    playse(SE_CLICK)
    waitse
    setflag(FLAG_ARH_PUZZLE3)
    setmetatile(10, 10, 0x500, FALSE)
    setmetatile(11, 10, 0x500, FALSE)
    setmetatile(12, 10, 0x500, FALSE)
    setmetatile(10, 11, 0x500, FALSE)
    setmetatile(11, 11, 0x500, FALSE)
    setmetatile(12, 11, 0x500, FALSE)
    playse(SE_EXIT)
    special(DrawWholeMapView)
    msgbox("旧机器嗡嗡地运转起来。\p走廊里的中央卷帘门\n好像打开了。")
    release
}

// Red-herring machine text.
script ARH_MachineRight2 {
    msgbox("暗影测量监视器\p最后的读数定格在\n昏暗的显示屏上。\p心率：220\n攻击性：错误\l情绪：0%", MSGBOX_SIGN)
}
