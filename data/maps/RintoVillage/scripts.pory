mapscripts RintoVillage_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_RINTO_VILLAGE)
        if (flag(FLAG_IS_CHAMPION)) {
            setvar(VAR_POSTGAME_UNLOCKS_STATE, 1)
        }
        end
        }
}

script Rinto_Sign {
    msgbox("林都村\n阳光沐浴的村庄", MSGBOX_SIGN)
}

script Rinto_OldLady {
    msgbox("哎呀，又来了游客吗？\p希望您不介意\n气温变化这么大！呵呵呵！", MSGBOX_NPC)
}

script Rinto_TempleSage {
    msgbox("我以前是熔岩队的一员。\p离开以后，我决定\n以朝圣者的身份周游世界。\p能见识世界的美好，\n真是让人神清气爽。", MSGBOX_NPC)
}

script Rinto_Gible {
    lock
    faceplayer
    playmoncry(SPECIES_GIBLE, CRY_MODE_NORMAL)
    msgbox("圆陆鲨：嘎嘎！")
    waitmoncry
    release
    end
}

script Rinto_Maractus {
    lock
    faceplayer
    playmoncry(SPECIES_MARACTUS, CRY_MODE_NORMAL)
    msgbox("沙铃仙人掌：沙啊啊伊！")
    waitmoncry
    release
    end
}

script Rinto_Piplup {
    lock
    msgbox("……波加曼好像睡着了。")
    release
    end
}

script Rinto_Gentleman {
    lock
    faceplayer
    if (flag(FLAG_GOT_TM_REST)) {
        msgbox("“睡觉”能让您恢复体力，\n继续上路。\p别硬撑，\n记得抽空好好休养。")
        release
        end
    }
    msgbox("远行之后好好休息，\n同样重要！年轻也别\l不顾身体！\p这个给您。")
    giveitem(ITEM_TM_REST)
    setflag(FLAG_GOT_TM_REST)
    msgbox("“睡觉”能让您恢复体力，\n继续上路。\p别硬撑，\n记得抽空好好休养。")
    release
    end
}

script Rinto_EastGuard {
    msgbox("现在沙暴太猛了。\n在它平息之前，\l我不能放您过去。", MSGBOX_NPC)
}

script Rinto_TriggerEastGuard {
    lock
    applymovement(LOCALID_RINTO_EAST_GUARD, moves(walk_in_place_down))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement
    msgbox("现在沙暴太猛了。\n在它平息之前，\l我不能放您过去。")
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement
    release
    end
    
}

script Rinto_LittleGirl {
    msgbox("我看见了！\p红的和蓝的！\p它们往东边飞过镇子了！", MSGBOX_NPC)
}

script Rinto_Fatman {
    msgbox("要不是有那一小处\n通向大海的缺口，\l这烈日早把这里烤得没法住人了。", MSGBOX_NPC)
}

script Rinto_Dancer {
    lock
    msgbox("上吧，花舞鸟！露一手给他们看！")
    release
    end
}

script Rinto_DancerOricorio {
    lock
    playmoncry(SPECIES_ORICORIO_SENSU, CRY_MODE_NORMAL)
    msgbox("哩咿咿！")
    waitmoncry
    release
    end
}

script Rinto_Merchant {
    lock
    faceplayer
    msgbox("嘿，来看看我的货吧！")
    pokemart(Rinto_Stall)
    msgbox("欢迎您再来！")
    release
    end
}

mart Rinto_Stall {
    ITEM_RING_TARGET
    ITEM_BINDING_BAND
    ITEM_EJECT_BUTTON
    ITEM_WIDE_LENS
    ITEM_WISE_GLASSES
    ITEM_EXPERT_BELT
}

script Rinto_GameboyKid {
    msgbox("西边那座金字塔\n已经锁了很久了。\p我怀疑打开它的钥匙\n现在还存在吗？", MSGBOX_NPC)
}
