mapscripts Route49_MapScripts {}

script Route49_Desert_Sign {
    msgbox("{RIGHT_ARROW}金刚沙漠\n{UP_ARROW}雪顶山", MSGBOX_SIGN)
}

script Route49_RoadSign {
    msgbox("49号道路\n前方气候严酷。", MSGBOX_SIGN)
}

script Route49_FisherJo {
    trainerbattle_single(TRAINER_JO, "这是我的秘密钓点，看\n我刚钓上来的东西！", 
                                         "等等，你有几枚徽章？")
    msgbox("我钓鱼时会把女儿\n带上，好一家人聚聚。\l很高兴她有惊角鹿\l陪着一起玩。", MSGBOX_AUTOCLOSE)
}

script Route49_Girl {
    msgbox("爸爸钓鱼的时候，\n我喜欢和惊角鹿到处爬。", MSGBOX_NPC)
}

script Route49_Stantler {
    lock
    faceplayer
    playmoncry(SPECIES_STANTLER, CRY_MODE_NORMAL)
    msgbox("惊角鹿：咩啊啊啊！")
    waitmoncry
    release
    end
}

script Route49_CooltrainerEma {
    trainerbattle_single(TRAINER_EMA, "我来检验你\n有没有准备好面对前方\l更严酷的环境！",
                                       "你合格了！")
    msgbox("不管是沙漠还是雪顶山，\n都会考验你作为\l训练家的实力。", MSGBOX_AUTOCLOSE)
}

script Route49_Fatman {
    msgbox("山上冰冷的雪化成水\n流到这儿来。真是\l清澈啊！", MSGBOX_NPC)
}

script Route49_Hiker {
    msgbox("这里叫作千级台阶。\n爬到顶上，就到\l雪顶山脚下了。\p最近有传闻说，\n有人目击一只威严的蓝色鸟\l在山周围飞翔。", MSGBOX_NPC)
}
