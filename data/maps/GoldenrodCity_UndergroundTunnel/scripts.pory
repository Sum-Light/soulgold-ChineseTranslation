`

script goldenrod_utility_shop_girl {
    lock
    msgbox("欢迎！来看看本店的独家商品吧！")
    waitmessage
    pokemart(goldenrod_utility_shop)
    msgbox("再多买一点吧！")
    release
}

mart goldenrod_utility_shop {
    ITEM_UTILITY_UMBRELLA
    ITEM_COVERT_CLOAK
    ITEM_ABILITY_SHIELD
    ITEM_CLEAR_AMULET
	ITEM_AIR_BALLOON
}

script suspiciousdoor_goldenrod_underground {
    lock
	if (var(VAR_NEWBARK_TOWN_STATE) < 12) {
		msgbox("门好像锁着，但能隐约听见\n门后远处传来什么动静。")
    	waitmessage
    
	} else {
		msgbox("门已经打开了。\p隧道里传来一片嘈杂的声响。")
	}
    release
    end
}

script rocket_bouncer {
    lock
    faceplayer
    if (var(VAR_NEWBARK_TOWN_STATE) >= 12) {
        msgbox("欢迎，\n老大吩咐过放你过去。")
    } else {
        msgbox(format("抱歉，小家伙。只有获得\n特别许可的人才能过去。"))
    }
    release
    end
}

script Goldenrod_TryOpenRocketArcadeDoor {
	setmetatile(12, 28, 0x45D, FALSE)
	return
}
	