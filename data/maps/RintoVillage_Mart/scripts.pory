mapscripts RintoVillage_Mart_MapScripts {}

script Rinto_Mart2 {
    lock
    faceplayer
    message("欢迎光临！您需要什么？")
    waitmessage
    pokemart(Rinto2)
    msgbox("欢迎下次再来！")
    release
    end
}

mart Rinto2 {
    ITEM_TM_BRICK_BREAK
    ITEM_TM_FACADE
    ITEM_TM_PLAY_ROUGH
    ITEM_DUSK_BALL
    ITEM_QUICK_BALL
}

script RintoMart_Youngster {
    msgbox("城都的每家友好商店\n都备有自家的招式学习器。\p全都收集齐可是很花钱的！",
           MSGBOX_NPC)
}

script RintoMart_Beauty {
    msgbox("我只是来这儿蹭\n空调的。", MSGBOX_NPC)
}
