mapscripts EcruteakCity_House3_MapScripts {}

script EcruteakCity_House3_HexLady {
    lock
    faceplayer
    if (flag(FLAG_TM_HEX)) {
            msgbox("祸不单行……威力会翻倍……\n命中陷入异常状态的\l对手时……")
            release
            end
    }
    msgbox("趁对手陷入异常状态时攻击……\n这是赢得对战的关键……\p来……拿去吧……")
    waitmessage
    giveitem(ITEM_TM_HEX)
    setflag(FLAG_TM_HEX)
    msgbox("祸不单行……威力会翻倍……\n命中陷入异常状态的\l对手时……")
    release
    end
}

script EcruteakCity_House3_Lampent {
    lock
    faceplayer
    playmoncry(SPECIES_LAMPENT, CRY_MODE_NORMAL)
    msgbox("灯火幽灵：啦唔！")
    release
    end
}
