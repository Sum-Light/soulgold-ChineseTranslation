mapscripts FoggyShore2_MapScripts {}

script NijoTrainer {
    trainerbattle_single(TRAINER_NIJO, "这种荒郊野外，\n你跑这儿来做什么？",
                                        "你不会有事的。")
    msgbox("附近的小路通向一座森林，\n很多人都在里面迷了路。\p要是打算进去，\n可得当心点。", MSGBOX_AUTOCLOSE)
    end
}

script SaeTrainer {
    trainerbattle_single(TRAINER_SAE, "安静的海滩，最适合度假了！",
                                        "清静全毁了！")
    msgbox("因为附近有闹鬼树林的传闻，\n很少有人会到这儿来。", MSGBOX_AUTOCLOSE)
    end
}

script FoggyShoreSign {
    msgbox("{UP_ARROW}迷失森林", MSGBOX_SIGN)
}

script FoggyShoreBuizel {
    lock
    faceplayer
    playmoncry(SPECIES_BUIZEL, CRY_MODE_NORMAL)
    msgbox("泳圈鼬：噗咿噗咿噗咿——！")
    waitmoncry
    release
    end
}