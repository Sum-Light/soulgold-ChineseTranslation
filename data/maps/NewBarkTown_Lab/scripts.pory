`

script NewBarkTown_Lab_GiveStarterMega {
	msgbox("对了，你还从大木博士那里\n拿到超级环了吧？\l那我想，你已经准备好\l处理这个东西了。")
	giveitem(ITEM_BONDSTONE, 1)
	msgbox("这是块特殊的超级石，专门\n给你最初的宝可梦用的。我期待\l你有出色的表现，{PLAYER}！")
	return
}

script NewBarkTown_Lab_EventScript_ElmPostgameHint {
	msgbox("空木：{PLAYER}！你在这儿啊！\n我打电话来，是因为听说\l对战塔开放了！\p听说有很强的训练家\n都聚集到那里去了！\p从浅葱市附近的40号水路\n就能到那里。")
	msgbox("不过在那之前，让我\n先给你的图鉴升级一个新功能！")
	playse(SE_CLICK)
	delay(10)
	playse(SE_CLICK)
	delay(10)
	playse(SE_CLICK)
	delay(10)
	playse(SE_PIN)
	waitse
	msgbox("现在你在战斗中按L键，\n就能查看对手宝可梦的\l特性了！\p战斗越来越艰难的时候，\n这一定会很方便！")
	setflag(FLAG_POSTGAME_FEATURES)
	setflag(FLAG_HIDE_VICTORYROAD_RIVAL)
	checkplayergender
	if (var(VAR_RESULT) == MALE) {
	msgbox("我还听说克丽丝去白银山\n修行了。\p不过我上次见到她的时候，\n她看起来真的很累……\p你方便的时候能去看看她吗？")
	} else {
	msgbox("我还听说阿响去白银山\n修行了。\p不过我上次见到他的时候，\n他看起来真的很累……\p你方便的时候能去看看他吗？")
	}
	msgbox("我已经向联盟申请过了，\n既然你是新冠军就放你通行。")
	setflag(FLAG_HIDE_MTSILVER_GUARD)
	setflag(FLAG_ALLOW_SOUTH_JOHTO_PASS)
	setvar(VAR_NEWBARKTOWN_LABSTATE, 11)
	setvar(VAR_NEWBARK_TOWN_STATE, 11)
	release
	end
}

script ElmIntro {
	msgbox("空木：{PLAYER}！你在这儿啊！\p我有件事想请你帮忙。\p我现在正在进行\n宝可梦的新研究。\p想请你来帮我一把，\n{PLAYER}。\p是这样……\p我正在写一篇论文，\n想在学会上发表。\p但还有一些地方\n我弄不太明白。\p所以！\p我想请你帮我培养一只\n我最近刚抓到的宝可梦。", MSGBOX_YESNO)
	return
}

script NewBarkTown_Lab_EventScript_ArtifactOfChaos {
	lock
	if (flag(FLAG_ALL_INNATES_UNLOCKED)) {
		msgbox("混沌遗物正在嗡鸣。\p所有天赋特性目前都\n已全部生效。")
		msgbox("要关闭混沌遗物吗？", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			playse(SE_PC_OFF)
			waitse
			clearflag(FLAG_ALL_INNATES_UNLOCKED)
			if (var(VAR_NEWBARKTOWN_LABSTATE) < 11) {
				clearflag(FLAG_POSTGAME_FEATURES)
			} else {
				setflag(FLAG_POSTGAME_FEATURES)
			}
			msgbox("混沌遗物的光芒黯淡下去。\p天赋特性将恢复在原本的\n等级解锁。")
		} else {
			msgbox("混沌遗物仍在嗡鸣。\n但愿空木还没注意到！")
		}
	} else {
		msgbox("书堆之中放着空木自己的\n混沌遗物。\p侧面贴着一张小小的标签：\n请勿触摸。")
		msgbox("注意！启动这件遗物，就能\n无视宝可梦的等级，\l解锁所有天赋特性。\p它还能让你在战斗中按L键\n查看对手的天赋特性。")
		msgbox("这并不是本作预期的玩法，\n游戏平衡也会完全失衡。\p如果你已经明白，仍然想\n启动它，请选择“是”。", MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			playse(SE_SWITCH)
			waitse
			setflag(FLAG_ALL_INNATES_UNLOCKED)
			clearflag(FLAG_REPLAY_NO_INNATES)
			msgbox("{PLAYER}碰了碰遗物。\p游戏平衡悄悄地\n离开了这栋建筑。\p所有天赋特性现已生效。\n战斗中按L键查看对手天赋特性。")
		} else {
			msgbox("{PLAYER}没有去碰遗物。\n今天，混沌没有得逞。")
		}
	}
	closemessage
	release
	end
}
