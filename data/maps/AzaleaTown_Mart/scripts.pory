raw `
AzaleaTown_Mart_MapScripts::
	.byte 0

AzaleaTown_Mart_EventScriptBugCatcher::
	lock
	faceplayer
	msgbox AzaleaMart_Text_BugCatcher, MSGBOX_DEFAULT
	closemessage
	release
	end

AzaleaMart_Text_BugCatcher:
	.string "用超级球抓宝可梦，\n比用精灵球更容易。\p不过有时候，\n钢铁做的球会更好用。$"
	.string ""
	.string ""
	.string ""

`

script AzaleaTownMart2 {
    lock
    faceplayer
    if (flag(FLAG_BADGE04_GET) == FALSE) {
        msgbox("伽勒豆蔻花圈和\n伽勒豆蔻手环暂时缺货。\p我们很快会补货的。\n总之，欢迎光临！")
        waitmessage
        pokemart(GalaricaNoneVendor)
        msgbox("欢迎下次再来！")
        release
        end
    }
    message("欢迎光临！\n伽勒尔的道具\l已经补货了！")
    waitmessage
    pokemart(GalaricaVendor)
    msgbox("欢迎下次再来！")
    release
    end
}

mart GalaricaVendor {
    ITEM_TM_INFESTATION
    ITEM_TM_GIGA_DRAIN
    ITEM_TM_X_SCISSOR
    ITEM_GALARICA_WREATH
    ITEM_GALARICA_CUFF
    ITEM_NEST_BALL
    ITEM_MECH_MAIL
}

mart GalaricaNoneVendor {
    ITEM_TM_GIGA_DRAIN
    ITEM_NEST_BALL
    ITEM_MECH_MAIL
}

script AzaleaTownMartNpc {
    lock
    faceplayer
    if (flag(FLAG_BADGE04_GET)) {
        msgbox("伽勒尔的进化道具\n补货了！")
        release
        end    
    }
    msgbox("听说火箭队把伽勒尔\n呆呆兽用的进化道具\l全都抢走了。")
    release
    end
}
