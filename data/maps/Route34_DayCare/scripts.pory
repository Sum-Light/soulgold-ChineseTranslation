	.string ""
	.string ""

Route34_DayCare_Text_YoullBeLeftWithJustOne:
	.string "嗯？\n别急，别急。\p把那只宝可梦也交给我的话，\n你就只剩一只了。\p依我看，再多捉几只\n会比较好哦。$"
	.string ""
	.string ""
	.string ""
	.string ""
	.string ""
`

script daycareDestinyKnotGift {
	lock
	faceplayer
	if (flag(FLAG_DESTINYKNOT_GIFT)) {
		msgbox("红线能让宝可梦从父母那里\n遗传5项个体值。")
				release
				end
	}
	msgbox("嘿！你试过把宝可梦\n寄放到培育屋了吗？有时候\l培育屋夫妇会找到蛋。\p如果你打算大量孵蛋，\n这个或许用得上。")
	giveitem(ITEM_DESTINY_KNOT)
	setflag(FLAG_DESTINYKNOT_GIFT)
	msgbox("红线能让宝可梦从父母那里\n遗传5项个体值。")
	waitmessage
	release
	end
}

script Route34_EventScript_DaycareEggSentToPC {
	msgbox("你的队伍满了，所以蛋被\n送进了你的电脑。")
	return
}
