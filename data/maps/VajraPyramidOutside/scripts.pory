mapscripts VajraPyramidOutside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_RINTO_TRADE_COMPLETE)) {
            clearflag(FLAG_HIDE_PYRAMIDOUT_SCIENTIST)
        } else {
            setflag(FLAG_HIDE_PYRAMIDOUT_SCIENTIST)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_IS_CHAMPION) && flag(FLAG_RINTO_TRADE_COMPLETE)) {
            setmetatile(16, 6, 0x4D5, FALSE)
        }
    }
}

script VajraPyramidOutside_Door {
    if (flag(FLAG_IS_CHAMPION) && flag(FLAG_RINTO_TRADE_COMPLETE)) {
        msgbox("这扇门是被反复猛撞之后\n才被撞开的。", MSGBOX_SIGN)
    } else {
        msgbox("门紧紧地封着。", MSGBOX_SIGN)
    }
}

script VajraPyramidOutside_ScientistPostgame {
    if (flag(FLAG_IS_CHAMPION)) {
        msgbox("多亏你给我们的巨锻匠，\n我们终于把金字塔的门\l弄开了！\p请吧，你可以先去\n里面探索一下！", MSGBOX_NPC)
    } else {
        msgbox("我们已经开始借助你的\n巨锻匠，着手把那扇门\l弄开了！\p这可能需要一些时间，\n你过一阵子再来吧。", MSGBOX_NPC)
    }
}

script VajraPyramidOutside_ScientistsTinkaton {
    lock
    faceplayer
    playmoncry(SPECIES_TINKATON, 0)
    msgbox("巨锻匠：锻咿！")
    waitmoncry
    msgbox("你那只巨锻匠好像\n在这里玩得很开心！")
    release
    end
}

script VajraPyramidOutside_RuinManiac {
    msgbox("这里有等着被揭开的谜团！\n我能感觉到！", MSGBOX_NPC)
}